import heapq
import pandas as pd

def uniform_cost_search(start, goals, graph):
   
    pq = [(0, start, [])]  # Priority queue to store (cost, node, path)
    visited = {}  # Stores the minimum 
    goal_paths = {}  # Stores cost

    while pq:
        cost, node, path = heapq.heappop(pq)

        # If the node is already visited with a lower cost, skip 
        if node in visited and visited[node] <= cost:
            continue
        
        visited[node] = cost
        path = path + [node]

        # If this node is a goal, store the result
        if node in goals:
            goal_paths[node] = (cost, path)
            if len(goal_paths) == len(goals):  # Stop if all goals found
                return goal_paths

        # Expand neighbors
        for neighbor, edge_cost in graph.get(node, []):
            if neighbor not in visited or cost + edge_cost < visited[neighbor]:
                heapq.heappush(pq, (cost + edge_cost, neighbor, path))

    return goal_paths  # Return all found goal paths

