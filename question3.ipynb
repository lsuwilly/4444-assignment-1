# Run on  graph
results = {}
for test in test_graphs:
    results[test["name"]] = uniform_cost_search(test["start"], test["goals"], test["graph"])

# Display results
df_results = []
for name, goal_results in results.items():
    for goal, (cost, path) in goal_results.items():
        df_results.append({"Graph": name, "Goal Node": goal, "Cost": cost, "Path": " → ".join(map(str, path))})

df = pd.DataFrame(df_results)
print(df)
